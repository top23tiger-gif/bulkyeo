<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="정해진 시간마다 영어 한 문장을 알려드려요"
            android:textColor="@color/inkSoft"
            android:textSize="17sp" />

        <!-- 알림 권한이 꺼져 있을 때만 보이는 안내 -->
        <LinearLayout
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_warning"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="알림이 꺼져 있어요. 알림을 켜야 영어 문장을 받을 수 있어요."
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnPermission"
                style="@style/MainButton"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_primary"
                android:text="알림 켜기"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 최근 문장 미리보기 (누르면 크게 보기) -->
        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="bottom"
                android:background="@drawable/shade_bottom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/previewEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:shadowColor="#000000"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/previewKorean"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:shadowColor="#000000"
                    android:shadowRadius="6"
                    android:textColor="#FFE58A"
                    android:textSize="17sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnOpen"
            style="@style/MainButton"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_primary"
            android:text="📖 문장 크게 보기"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="⏰ 알림 시간"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/timesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnAddTime"
            style="@style/MainButton"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_outline"
            android:text="＋ 알림 시간 추가"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/btnTest"
            style="@style/MainButton"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_outline"
            android:text="🔔 지금 알림 한번 받아보기"
            android:textColor="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="알림을 누르면 그림과 함께 문장이 크게 나와요.\n🖼 배경 바꾸기로 좋아하는 영화 장면 사진을 넣을 수도 있어요."
            android:textColor="@color/inkSoft"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
